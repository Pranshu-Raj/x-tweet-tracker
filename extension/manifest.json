{
  "manifest_version": 3,
  "name": "X Growth Cockpit — Capture",
  "version": "0.1.0",
  "description": "Capture your own X follower count and tweet stats into the local X Growth Cockpit app.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "background": { "service_worker": "service_worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Cockpit Capture" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
