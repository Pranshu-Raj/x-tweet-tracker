# Copy to .env.local for local dev. In production, set these in the Vercel dashboard.

# --- Database ---
# LOCAL DEV: leave both blank → the app uses Node's built-in node:sqlite at
# ./data/cockpit.db (offline, no setup). PRODUCTION: set these to your Turso DB.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth (single shared secret) ---
# LOCAL DEV: leave blank → auth is OFF (localhost only). PRODUCTION: set a long
# random string. The browser logs in with it at /login; the extension + reminders
# daemon send it as the access token.
COCKPIT_TOKEN=

# --- AI (optional; falls back to templates if unset) ---
# Backend is chosen by which key is present. Groq is the zero-cost default.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
